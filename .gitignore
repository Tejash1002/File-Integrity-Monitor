# Python
__pycache__/
*.pyc
*.pyo
venv/
env/
.venv/

# Generated at runtime — baselines and reports are user data, not source code
data/*.json
reports/*.txt
reports/*.json

# Keep the folders themselves tracked, just not their generated contents
!data/.gitkeep
!reports/.gitkeep

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db


# Phase 2 USB runtime data
data/usb_baselines/*.json
reports/usb/*.txt
reports/usb/*.json